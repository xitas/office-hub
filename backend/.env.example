# Copy to .env and fill in. Never commit .env.

# --- Core ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://crm:password@localhost:5432/office_crm
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Encryption key(s) for secrets stored in the database (2FA). REQUIRED, and separate from
# DJANGO_SECRET_KEY. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: put a new key first (comma-separated), run `python manage.py reencrypt_fields`,
# then remove the old key. Losing all keys makes existing 2FA secrets unreadable.
FIELD_ENCRYPTION_KEYS=

# --- Redis: Celery broker, cache (rate limits, WebSocket tickets), live updates ---
# Local: `docker compose up -d redis`. Leave empty to run without Redis (tasks run inline,
# rate limits and live updates are per process).
REDIS_URL=redis://127.0.0.1:6379/0

# --- Security ---------------------------------------------------------------
# Sign-in attempts per client IP (raise only for automated runs such as `npm run review`).
LOGIN_THROTTLE_RATE=10/min
# Trusted reverse proxies in front of Django. 0 = ignore X-Forwarded-For (clients can forge it).
# Set to 1 behind one nginx / load balancer that sets the header.
NUM_PROXIES=0
# Swagger UI at /api/docs/ (default on in development, off in production).
# API_DOCS_ENABLED=True

# --- Email --------------------------------------------------------------------
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Office CRM <noreply@example.com>

# --- Production only (config.settings.prod) ------------------------------------
# DJANGO_ALLOWED_HOSTS must list exact host names (no '*'); CORS_ALLOWED_ORIGINS is required.
# CSRF_TRUSTED_ORIGINS=https://crm.example.com     (defaults to CORS_ALLOWED_ORIGINS)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False                          (opt in once the domain is ready)
# CONTENT_SECURITY_POLICY=...                        (override the default policy)
