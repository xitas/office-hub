DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/office_crm
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Production only: enables the Redis channel layer
REDIS_URL=
# Sign-in attempts per IP (raise only for automated runs such as `npm run review`)
LOGIN_THROTTLE_RATE=10/min
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Office CRM <noreply@example.com>
